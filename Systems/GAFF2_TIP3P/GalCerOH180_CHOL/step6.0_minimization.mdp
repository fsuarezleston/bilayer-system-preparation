define                  = -DPOSRES -DPOSRES_FC_LIPID=1000.0 -DDIHRES -DDIHRES_FC=1000.0
integrator              = steep
emtol                   = 1000.0
emstep                  = 0.001
nsteps                  = 5000
cutoff-scheme           = Verlet
nstlist                 = 10
rlist                   = 1.0
vdwtype                 = Cut-off
vdw-modifier            = Potential-shift
DispCorr                = EnerPres
rvdw                    = 1.0
coulombtype             = PME
rcoulomb                = 1.0
;
constraints             = h-bonds
constraint_algorithm    = LINCS
